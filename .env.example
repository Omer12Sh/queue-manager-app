# =====================================================
# Queue Manager App — Environment Variables
# Copy this file to .env and fill in the values
# =====================================================

# ---- PostgreSQL ----
POSTGRES_USER=queueuser
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=queuemanager

# ---- Backend ----
DATABASE_URL=postgresql://queueuser:change_me_in_production@localhost:5432/queuemanager
JWT_SECRET=super-secret-jwt-key-change-in-production
JWT_EXPIRES=7d
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ---- Redis (optional — for appointment queue) ----
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# ---- Twilio (optional — for SMS / WhatsApp) ----
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# ---- OpenAI (optional — for AI assistant) ----
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- Frontend (Vite) ----
VITE_API_URL=http://localhost:4000
# Set to "true" to show demo-account quick-fill buttons on the login page (dev/demo only)
VITE_SHOW_DEMO=true
